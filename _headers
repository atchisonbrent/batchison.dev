# Fonts, CSS, and JS are all versioned URLs (?v=N or renamed on change), so
# they can cache forever - a version bump is what invalidates, not max-age.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

# Icons/og image are NOT versioned, so they keep a short-ish TTL.
/assets/img/*
  Cache-Control: public, max-age=86400

# CSP notes:
# - the script-src hash covers the inline theme-boot script in index.html
#   <head>; regenerate it if that script changes:
#   python3 -c "import re,hashlib,base64;print(base64.b64encode(hashlib.sha256(re.search(r'<script>(.*?)</script>',open('index.html').read(),re.S).group(1).encode()).digest()).decode())"
# - style-src stays 'unsafe-inline' for the <noscript> style block - hashing it
#   would force a regen on every tweak for marginal gain.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-WvmUqLMybuWDdP1aUefstBLpCt2j3pYpKM3/Xiz1hmA='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
