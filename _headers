# Fonts and CSS are versioned URLs (?v=N or renamed on change), so they can
# cache forever - a version bump is what invalidates, not max-age. The ?v=
# bump for CSS is enforced by .githooks/pre-push.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

# JS stays on a short revalidating cache: the ES module imports inside main.js
# are unversioned URLs, so immutable here would pin stale submodules for a
# year with no way to bust them.
/assets/js/*
  Cache-Control: public, max-age=600, must-revalidate

# Icons/og image are NOT versioned, so they keep a short-ish TTL.
/assets/img/*
  Cache-Control: public, max-age=86400

# CSP notes:
# - no inline scripts anywhere (the pre-paint boot lives in assets/js/boot.js),
#   so script-src is just 'self' - no hash to keep in sync.
# - style-src stays 'unsafe-inline' for the <noscript> style block - hashing it
#   would force a regen on every tweak for marginal gain.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
